digraph GameArch {
  node [
    shape = rectangle
  ];

  // Root

  platform [
    label = "Platform"
  ];

  core [
    label = "Core"
  ];

  // Platform

  display [
    label = "Display"
  ];

  event_handler [
    label = "Event handler"
  ];

  // Core

  game [
    label = "Game"
  ];

  game_create [
    label = "Create"
  ];

  game_update [
    label = "Update"
  ];

  game_destroy [
    label = "Destroy"
  ];

  // Platform connect

  platform -> display;
  platform -> event_handler;

  // Core connect

  core -> game;

  game -> game_create;
  game -> game_update;
  game -> game_destroy;
}
